{
  "socket": "/run/vm2api-magpie/kernel.sock",
  "internal_token_file": "/run/secrets/internal-token",
  "magpie_base_url": "http://magpie:3425",
  "magpie_api_key_file": "/run/secrets/gateway-key",
  "magpie_api_key_files": {
    "gemini-slots": "/run/secrets/gemini-slots-key",
    "claude-slots": "/run/secrets/claude-slots-key"
  },
  "first_byte_timeout_seconds": 90,
  "stream_idle_timeout_seconds": 120,
  "queue_wait_seconds": 30,
  "default_max_concurrency": 2,
  "default_max_rpm": 30,
  "default_queue_limit": 16,
  "allow_dynamic_slots": true,
  "default_allowed_backends": ["agy-cli", "claude"],
  "slots": {
    "slot-agy": {
      "backend": "agy-cli",
      "model": "agy-cli/gemini-4-flash",
      "allowed_backends": ["agy-cli", "claude"],
      "magpie_account": ""
    },
    "slot-claude": {
      "backend": "claude",
      "model": "claude/claude-sonnet-5-5",
      "allowed_backends": ["agy-cli", "claude"],
      "magpie_account": ""
    }
  }
}
